generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PATIENT
  DOCTOR
  SUPERADMIN
}

enum AccountStatus {
  ACTIVE
  PENDING
  REJECTED
  BANNED
}

enum ConversationRole {
  PATIENT
  DOCTOR
}

enum AssistantPersona {
  DOCTOR
  NURSE
  OWL
  RESCUE_DOG
}

enum DoctorPatientLinkStatus {
  PENDING
  ACTIVE
  EXPIRED
}

enum PatientReportStatus {
  DRAFT
  APPROVED
  SENT
}

enum AppointmentStatus {
  REQUESTED
  ACCEPTED
  REJECTED
  CANCELED
  RESCHEDULED
}

enum MessageAuthor {
  USER
  ASSISTANT
  SYSTEM
}

model User {
  id             Int            @id @default(autoincrement())
  email          String         @unique
  emailVerified  Boolean        @default(false)
  passwordHash   String
  fullName       String
  role           UserRole
  status         AccountStatus  @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  patientProfile Patient?       @relation("PatientOwner")
  doctorProfile  DoctorProfile? @relation("DoctorOwner")
  reviewedDoctors DoctorProfile[] @relation("DoctorReviewer")
  conversations  Conversation[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]

  doctorPatientLinks DoctorPatientLink[] @relation("DoctorPatientLinkDoctor")
  pairingOtps PairingOtp[] @relation("PairingOtpDoctor")
  patientReports PatientReport[] @relation("PatientReportDoctor")
  doctorAppointments Appointment[] @relation("AppointmentDoctor")
}

model EmailVerificationToken {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

model PasswordResetToken {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

model Patient {
  id              Int              @id @default(autoincrement())
  userId          Int?             @unique
  user            User?            @relation("PatientOwner", fields: [userId], references: [id])
  fullName        String
  age             Int?
  sex             String?
  city            String?
  assistantPersona AssistantPersona @default(DOCTOR)
  // Legacy columns (exist in some dev DBs). Kept for safety to avoid data loss during migration.
  assistantType   String?
  assistantEnvironment String?
  medicalMemory   String?
  medicalMemoryUpdatedAt DateTime?
  createdAt       DateTime         @default(now())
  symptomReports  SymptomReport[]
  doctorAnalyses  DoctorAnalysis[]

  doctorPatientLinks DoctorPatientLink[] @relation("DoctorPatientLinkPatient")
  pairingOtps PairingOtp[] @relation("PairingOtpPatient")
  patientReports PatientReport[] @relation("PatientReportPatient")
  appointments Appointment[] @relation("AppointmentPatient")
}

model DoctorProfile {
  id              Int       @id @default(autoincrement())
  userId          Int       @unique
  user            User      @relation("DoctorOwner", fields: [userId], references: [id])
  specialty       String
  licenseNumber   String    @unique
  yearsExperience Int?
  bio             String?
  clinicName      String?
  clinicAddress   String?
  clinicCity      String?
  clinicLat       Float?
  clinicLng       Float?
  clinicHours     String?
  reviewedById    Int?
  reviewedBy      User?     @relation("DoctorReviewer", fields: [reviewedById], references: [id])
  approvalNote    String?
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())
}

model Conversation {
  id        Int              @id @default(autoincrement())
  userId    Int
  user      User             @relation(fields: [userId], references: [id])
  role      ConversationRole
  title     String
  // For DOCTOR conversations: lock this thread to a specific patient to prevent data mixing.
  // Nullable so existing conversations can still work.
  patientId Int?
  // When set, the doctor-patient access expires and the conversation becomes inaccessible.
  lockedUntil DateTime?
  summary   String?
  summaryUpdatedAt DateTime?
  summaryMessageCount Int @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  messages  ChatMessage[]
}

model ChatMessage {
  id             Int           @id @default(autoincrement())
  conversationId Int
  conversation   Conversation  @relation(fields: [conversationId], references: [id])
  author         MessageAuthor
  content        String
  imagesJson      String?
  triageLevel    String?
  createdAt      DateTime      @default(now())
}

model SymptomReport {
  id              Int      @id @default(autoincrement())
  patient         Patient? @relation(fields: [patientId], references: [id])
  patientId       Int?
  message         String
  location        String?
  triageLevel     String
  emotionLevel    String?
  triageSummary   String
  guidance        String
  nextStep        String
  specialist      String
  doctorsJson     String
  aiMode          String   @default("live")
  usedGooglePlace Boolean  @default(false)
  createdAt       DateTime @default(now())
}

model DoctorAnalysis {
  id                        Int      @id @default(autoincrement())
  patient                   Patient? @relation(fields: [patientId], references: [id])
  patientId                 Int?
  doctorUserId              Int?
  patientProfile            String
  triageLevel               String
  symptoms                  String
  medicalData               String?
  clinicalSummary           String
  hypothesesJson            String
  patientFriendlyExplanation String
  createdAt                 DateTime @default(now())
}

model DoctorPatientLink {
  id           Int                       @id @default(autoincrement())
  doctorUserId Int
  doctor       User                      @relation("DoctorPatientLinkDoctor", fields: [doctorUserId], references: [id])
  patientId    Int
  patient      Patient                   @relation("DoctorPatientLinkPatient", fields: [patientId], references: [id])
  status       DoctorPatientLinkStatus @default(PENDING)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  // Access validity window for ACTIVE link.
  expiresAt   DateTime?

  @@index([doctorUserId, patientId])
}

model PairingOtp {
  id           Int      @id @default(autoincrement())
  doctorUserId Int
  doctor       User     @relation("PairingOtpDoctor", fields: [doctorUserId], references: [id])
  patientId    Int
  patient      Patient  @relation("PairingOtpPatient", fields: [patientId], references: [id])
  otpHash      String   @unique
  expiresAt    DateTime
  attempts     Int      @default(0)
  consumedAt   DateTime?
  createdAt    DateTime @default(now())

  @@index([doctorUserId, patientId])
}

model PatientReport {
  id           Int               @id @default(autoincrement())
  patientId    Int
  patient      Patient          @relation("PatientReportPatient", fields: [patientId], references: [id])
  doctorUserId Int
  doctor       User             @relation("PatientReportDoctor", fields: [doctorUserId], references: [id])
  status       PatientReportStatus @default(DRAFT)

  triageLevel  String?
  triageSummary String?
  guidance     String?
  nextStep     String?
  specialist   String?

  doctorDraftText String
  patientFinalText String?

  emotionLevel String?

  approvedAt   DateTime?
  sentAt       DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([patientId, status])
  @@index([doctorUserId, patientId, createdAt])
}

model Appointment {
  id           Int               @id @default(autoincrement())
  patientId    Int
  patient      Patient          @relation("AppointmentPatient", fields: [patientId], references: [id])
  doctorUserId Int
  doctor       User             @relation("AppointmentDoctor", fields: [doctorUserId], references: [id])
  status       AppointmentStatus @default(REQUESTED)
  requestedAt  DateTime          @default(now())
  scheduledFor DateTime?
  patientNote  String?
  doctorNote   String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([doctorUserId, status])
  @@index([patientId, status])
}
